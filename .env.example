UNITY_VERSION="2022.3.62f1"
# 同时处理的 bundle / 新旧版本对数（1–32）；限制在途数据，内存不足时降低
ASSET_PIPELINE_CONCURRENCY=4
# QUICK_UNPACK_CONCURRENCY=4
# 解包 + 音频解码并发（1–32），与网络连接数独立
UNPACK_CONCURRENCY=4
# 全局并发网络请求（1–64）；包含不同文件及单文件分段
DOWNLOAD_CONCURRENCY=8
# 每个 bundle 的下载连接数（1–16）；1 为普通整包下载
DOWNLOAD_THREADS=4
# 每段大小 MiB（1–64）；不支持 Range 的服务器自动整包下载
DOWNLOAD_CHUNK_SIZE_MB=4

# 网络代理：支持 HTTP / HTTPS / SOCKS，覆盖所有项目下载入口
# 留空时先使用 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY（也支持小写），再检测 macOS 系统代理
# 自动检测遵守 NO_PROXY 和系统绕过规则；系统配置缓存 30 秒
GARUPA_PROXY_URL=""
# 显式 URL 优先于上述环境变量（包括 NO_PROXY）；direct 强制直连
# GARUPA_PROXY_URL="http://127.0.0.1:7890"
# GARUPA_PROXY_URL="socks5h://127.0.0.1:7890"

# ── SuiteMaster 下载（src/suiteMaster.ts）──
# AES 加解密密钥，必填
GARUPA_AES_KEY=""
GARUPA_AES_IV=""
# 客户端版本：FORCE 强制指定（跳过自动拉取）；DEFAULT 为拉取失败时的兜底
# GARUPA_CLIENT_VERSION_FORCE="10.1.4"
# GARUPA_CLIENT_VERSION_DEFAULT="10.1.4"

# ── 实时预解包服务（yarn server:notify + yarn server:unpack）──
# application 与猜测版本 CDN 各自独立轮询；bundle 未部署完整时会在后续轮次继续补
UNPACK_SERVER_APPLICATION_POLL_MS=15000
UNPACK_SERVER_CDN_POLL_MS=10000
UNPACK_SERVER_CONCURRENCY=4
UNPACK_SERVER_HOST="127.0.0.1"
UNPACK_SERVER_PORT=3210
# 输出及持久状态（相对项目根目录，也可填绝对路径）
UNPACK_SERVER_OUTPUT_DIR="assets/server"
UNPACK_SERVER_STATE_FILE="out/unpack-server-state.json"
# hash 自动从 AssetBundleInfoUrl.json 读取；只有自动反查不到时才需显式覆盖
# UNPACK_SERVER_CDN_HASH=""

# OneBot v11 HTTP API（服务端会调用 send_group_msg / upload_group_file）
ONEBOT_API_BASE_URL="http://127.0.0.1:3000"
ONEBOT_ACCESS_TOKEN=""
# 多个群号用英文逗号分隔；每个群独立记录发送状态
ONEBOT_GROUP_IDS=""
# true：同一 bundle 解包批次内的多张图片合并成一条消息；false：每张图单独发送
ONEBOT_MERGE_BUNDLE_IMAGES=false
# OneBot 与本进程不共享文件系统时，配置映射到 UNPACK_SERVER_OUTPUT_DIR 的公开 URL
# ONEBOT_FILE_BASE_URL="https://example.com/garupa-assets"
# 本地调试：不请求 OneBot，只打印本来要发送的消息
UNPACK_SERVER_DRY_RUN=false
# 仅用于隔离状态的历史回放：允许用较新 SuiteMaster 按清单差异过滤目标牌/歌曲。
UNPACK_SERVER_HISTORICAL_REPLAY=false
